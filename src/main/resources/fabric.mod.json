{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}+${minecraft_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${fabric_mod_contributors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.modgarden.flowerbed.Flowerbed"
    ],
    "client": [
      "net.modgarden.flowerbed.client.FlowerbedClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    {
      "config": "${mod_id}.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "${fabric_loader_range}",
		"fabric-api": ">=0.125.0",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}",
	  "fabric-permissions-api-v0": "*"
  }
}
