{
	"schemaVersion": 1,
	"id": "flowerbed",
	"version": "${version}",
	"name": "Flowerbed",
	"description": "A utility mod for Mod Garden events. ",
	"authors": [
		"Mod Garden"
	],
	"contributors": [
		"MerchantCalico"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/flowerbed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.modgarden.flowerbed.Flowerbed"
		],
		"client": [
			"net.modgarden.flowerbed.client.FlowerbedClient"
		]
	},
	"mixins": [
		"flowerbed.mixins.json",
		{
			"config": "flowerbed.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	}
}